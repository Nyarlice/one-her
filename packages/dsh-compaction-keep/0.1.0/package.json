{
  "name": "dsh-compaction-keep",
  "version": "0.1.0",
  "description": "DSH plugin: compaction keeps her own words, unfinished business, reasons and state, and writes the checkpoint in the conversation's own language instead of English engineering prose.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "memory",
    "continuity",
    "cordis"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.7-rc.2": "compatible"
      },
      "profiles": [
        "desktop",
        "web"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Nyarlice",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nyarlice/one-her.git"
  }
}
